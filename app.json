{
  "expo": {
    "name": "Consulta",
    "slug": "consulta-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cbernal.consulta"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cbernal.consulta"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Consulta",
      "shortName": "Consulta",
      "lang": "es",
      "themeColor": "#2f6f6a",
      "backgroundColor": "#f5f6f4"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Opener-Policy": "same-origin",
            "Cross-Origin-Embedder-Policy": "require-corp"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Consulta usa Face ID para proteger los datos de los pacientes."
        }
      ],
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "Consulta añade las citas a tu calendario y muestra tus otros compromisos para no dar citas encima."
        }
      ]
    ],
    "scheme": "consulta",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b423a5e4-6bd0-49e6-b69b-57bce0d306b4"
      }
    },
    "owner": "cbernal"
  }
}
